# Homelab PR previews (.github/workflows/pr-preview.yml).
#
# Same app as the production Dockerfile, but a throwaway instance: it serves on
# $PORT (8080 in the cluster), runs as a non-root user and loads the demo
# library on start so reviewers see shelves, stats and a calendar with content.
# The SQLite file lives inside the container and disappears with it.
FROM python:3.13-slim-bookworm AS builder

RUN pip install uv
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1
ENV UV_LINK_MODE=copy

RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --frozen --no-install-project --no-dev

FROM python:3.13-slim-bookworm

WORKDIR /app
COPY --from=builder /app/.venv /app/.venv
COPY . .

ENV PATH="/app/.venv/bin:$PATH" \
    PORT=8080 \
    PYTHONUNBUFFERED=1

RUN useradd --system --uid 10001 --home /app alexandria \
    && mkdir -p instance \
    && chown -R alexandria:alexandria /app/instance

USER 10001
EXPOSE 8080

CMD ["sh", "-c", "flask db upgrade && python scripts/seed_demo.py && exec gunicorn -w 1 -b 0.0.0.0:${PORT} app:app"]
